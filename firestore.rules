rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — public read, self-write only
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Game history is append-only via the server (Admin SDK)
      match /gameHistory/{entry} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Per-game leaderboard and per-user scores
    // Structure: games/{gameId}/scores/{uid}
    //            games/{gameId}/leaderboard/top-players
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;

      match /scores/{uid} {
        allow read: if true;   // anyone can look up a player's score
        allow write: if false; // server-only via Admin SDK
      }

      match /leaderboard/{doc} {
        allow read: if true;   // public leaderboard
        allow write: if false; // server-only via Admin SDK
      }
    }

    // Server-only internal collections
    match /gameSessions/{doc} {
      allow read, write: if false;
    }
    match /rateLimits/{doc} {
      allow read, write: if false;
    }
    match /scoreStats/{doc} {
      allow read, write: if false;
    }
    match /flaggedScores/{doc} {
      allow read, write: if false;
    }
  }
}
