rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Game history is append-only via the server
      match /gameHistory/{entry} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false; // server-only via Admin SDK
      }
    }

    // Leaderboard collections are read-only to clients; written server-side
    match /bestScores/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /bestScoresByDiff/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Sessions, rate limits, stats, and flagged scores are server-only
    match /gameSessions/{doc} {
      allow read, write: if false;
    }
    match /rateLimits/{doc} {
      allow read, write: if false;
    }
    match /scoreStats/{doc} {
      allow read, write: if false;
    }
    match /flaggedScores/{doc} {
      allow read, write: if false;
    }
  }
}
